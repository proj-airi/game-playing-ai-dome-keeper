{
  "name": "airi-dome-keeper-root",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "mods/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && bun run --cwd packages/status-dashboard typecheck",
    "build": "bun run --parallel --filter '*' build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.2",
    "@types/node": "^25.2.2",
    "bun-types": "^1.3.9",
    "eslint": "^10.0.0",
    "nanoid": "^6.0.0",
    "tinyexec": "^1.0.2",
    "typescript": "^5.9.3"
  }
}
