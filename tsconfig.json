{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "alint.config.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "packages/**/*.ts",
    "examples/**/*.ts",
    "mods/*/test/**/*.ts"
  ],
  "exclude": [
    "packages/vidot",
    "packages/vikeeper",
    "packages/status-dashboard"
  ]
}
