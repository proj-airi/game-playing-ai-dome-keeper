  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vidot/vitest": "workspace:*",
    "@vikeeper/vitest": "workspace:*",
    "typescript": "catalog:",
    "typescript-to-gdscript": "catalog:",
    "vitest": "catalog:"
  }
}
