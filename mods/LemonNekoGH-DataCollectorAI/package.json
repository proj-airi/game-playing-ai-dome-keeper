{
  "name": "lemonnekogh-ai",
  "type": "module",
  "private": true,
  "module": "index.ts",
  "scripts": {
    "build": "tstogd convert",
    "test": "vitest run --config test/vitest.config.ts",
    "test:build": "cd test && tstogd convert --tsconfig tsconfig.godot.json --project-root \"../../../external/domekeeper-decompiled/$DOMEKEEPER_VERSION\"",
